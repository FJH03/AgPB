import os

for sdk_target in MMSPlugin.sdk_targets:
  sdk = sdk_target.sdk
  cxx = sdk_target.cxx

  binary = MMSPlugin.HL2Library(builder, cxx, 'agpb_mm', sdk)

  binary.sources += [
    'src/plugin.cpp',
    'src/bot.cpp',
    'src/netvars.cpp',
    'src/waypoint.cpp',
  ]

  nodes = builder.Add(binary)
  MMSPlugin.binaries += [nodes]
