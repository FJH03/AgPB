# vim: set sts=2 ts=8 sw=2 tw=99 et ft=python:
#
# Packaging script, SourceMod / Metamod style.
# AMBuild reads build scripts with the system locale codec (GBK here), so this
# file must stay pure ASCII -- see AGENTS.md.
#
# After "ambuild" this produces build/package/:
#   addons/AgPB/bin/win64/agpb_mm.dll
#   addons/AgPB/configs/defaults/   (shipped configuration)
#   addons/AgPB/waypoints/          (shipped waypoints)
#   addons/metamod/AgPB.vdf
#   addons/sourcemod/scripting/agpb_zr_bridge.sp
#   addons/sourcemod/plugins/agpb_zr_bridge.smx (with --with-spcomp)
import os

builder.SetBuildFolder('package')

BIN64_FOLDER = {
  'windows': 'win64',
  'linux': 'linuxsteamrt64',
  'mac': 'osx64',
}

plugin_name = MMSPlugin.metadata['name']

# Ship the vdf from configs/metamod/ (SourceMod layout: addons/ exists only in the package).
metamod_folder = builder.AddFolder(os.path.join('addons', 'metamod'))
builder.AddCopy(
  os.path.join(builder.sourcePath, 'configs', 'metamod', plugin_name + '.vdf'),
  metamod_folder)

for task in MMSPlugin.binaries:
  target = task.target
  if target.arch == 'x86_64':
    bin_path = os.path.join('addons', plugin_name, 'bin', BIN64_FOLDER[target.platform])
  else:
    bin_path = os.path.join('addons', plugin_name, 'bin')

  bin_folder = builder.AddFolder(bin_path)
  builder.AddCopy(task.binary, bin_folder)

# Package the waypoint tree with its relative paths intact.
waypoint_source = os.path.join(builder.sourcePath, 'waypoints')
waypoint_path = os.path.join('addons', plugin_name, 'waypoints')
waypoint_folder = builder.AddFolder(waypoint_path)
for source_dir, subdirs, files in os.walk(waypoint_source):
  subdirs.sort()
  builder.AddConfigureFile(source_dir)
  relative_dir = os.path.relpath(source_dir, waypoint_source)
  package_folder = waypoint_folder
  if relative_dir != '.':
    package_folder = builder.AddFolder(os.path.join(waypoint_path, relative_dir))
  for name in sorted(files):
    builder.AddCopy(os.path.join(source_dir, name), package_folder)

# Keep shipped defaults below the server's editable configuration directory.
defaults_folder = builder.AddFolder(os.path.join('addons', plugin_name, 'configs', 'defaults'))
for name in ('names.cfg', 'weapons.cfg'):
  builder.AddCopy(os.path.join(builder.sourcePath, 'configs', name), defaults_folder)

# The bridge can also be compiled using an installed SourceMod toolchain.
sm_path = os.path.join('addons', 'sourcemod')
bridge_source = os.path.join(builder.sourcePath, 'compat', 'sourcemod', 'agpb_zr_bridge.sp')
builder.AddCopy(bridge_source, builder.AddFolder(os.path.join(sm_path, 'scripting')))

if builder.options.with_spcomp:
  spcomp = os.path.abspath(builder.options.with_spcomp)
  sp_include = os.path.join(os.path.dirname(spcomp), 'include')
  if not os.path.isfile(spcomp) or not os.path.isfile(os.path.join(sp_include, 'sourcemod.inc')):
    raise Exception('--with-spcomp requires a SourcePawn compiler with a sibling include directory.')

  sm_plugins = builder.AddFolder(os.path.join(sm_path, 'plugins'))
  bridge_binary = 'agpb_zr_bridge.smx'
  # spcomp -h emits include dependencies using the MSVC showIncludes format.
  builder.AddCommand(
    inputs=[spcomp, bridge_source],
    argv=[spcomp, '-i' + sp_include, '-h', '-E', '-o' + bridge_binary, bridge_source],
    outputs=[bridge_binary],
    folder=sm_plugins,
    dep_type='msvc')
